# Copy this file to ".env" and fill in the values. Docker Compose reads .env
# automatically. The .env file itself is not tracked in version control.

# --- Local PostgreSQL container ---
POSTGRES_DB=eease
POSTGRES_USER=eease
POSTGRES_PASSWORD=eease
# A PostgreSQL installed on the host may already own port 5432, so the container
# binds to 5433 by default to avoid the clash.
POSTGRES_PORT=5433

# --- API ---
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# Leave this commented out when using the bundled Postgres container; Compose
# connects to the "postgres" service by default.
#
# To use Neon, uncomment the line below and put your own connection string in.
# Neon requires SSL, so "SSL Mode=Require" and "Trust Server Certificate=true"
# are mandatory:
# ConnectionStrings__PostgreSQL=Host=ep-xxxx.eu-central-1.aws.neon.tech;Port=5432;Database=neondb;Username=xxxx;Password=xxxx;SSL Mode=Require;Trust Server Certificate=true;Pooling=true

# --- JWT ---
# SecurityKey must be at least 32 characters. Always change it in production.
Token__Issuer=eease-local
Token__Audience=eease-local
Token__SecurityKey=local-development-only-signing-key-change-me-32chars

# --- External services ---
GEMINI_API_KEY=
GOOGLE_PLACES_API_KEY=

# --- Email ---
# Can be left off for local development; mail is only logged.
MailService__Enabled=false
MailService__Email=
MailService__Key=
MailService__Name=
